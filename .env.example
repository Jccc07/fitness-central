# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used to store Strava tokens and sync activities.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Strava (strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=make-up-a-long-random-string

# The public URL of this app (http://localhost:3000 locally, your https URL when deployed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
